<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.FootballAnalytics" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="colorPrimary">@color/brand</item>
        <item name="colorAccent">@color/brand</item>
        <item name="android:windowBackground">@color/page_bg</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">true</item>
    </style>

    <!-- Shown while the first page loads (androidx.core splashscreen, works back to API 23). -->
    <style name="Theme.FootballAnalytics.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/brand</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/splash_icon</item>
        <item name="postSplashScreenTheme">@style/Theme.FootballAnalytics</item>
    </style>
</resources>
