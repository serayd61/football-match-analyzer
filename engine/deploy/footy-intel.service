[Unit]
Description=Footy intel agent — settle yesterday + analyse whitelist fixtures ~24h ahead (after the 06:00 predict run)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=footy
WorkingDirectory=/opt/football-match-analyzer/engine
# --- DÜZENLE: /etc/footy/intel.env içinde ANTHROPIC_API_KEY, SUPABASE_URL, SUPABASE_SERVICE_ROLE_KEY,
#     STORE_PATH=/var/lib/footy/results.jsonl (son maç/H2H bağlamı), isteğe bağlı INTEL_MODEL / SITE_MODEL_VERSION ---
EnvironmentFile=/etc/footy/intel.env
ExecStart=/opt/football-match-analyzer/engine/.venv/bin/python intel_agent.py daily --write
TimeoutStartSec=3600
