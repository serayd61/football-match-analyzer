[Unit]
Description=Footy Predict Service (Dixon-Coles FastAPI)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# --- DÜZENLE: kullanıcı ve repo yolu ---
User=root
WorkingDirectory=/opt/football-match-analyzer/engine
# --- DÜZENLE: FotMob/Free API anahtarın (RapidAPI) ---
Environment=FOOTBALL_API_KEY=PASTE_YOUR_RAPIDAPI_KEY_HERE
Environment=STORE_PATH=/var/lib/footy/results.jsonl
Environment=MIN_LEAGUE_MATCHES=150
# ZORUNLU (2026-09-18): /predict, /backfill, /update, /reload bu token olmadan 503 döner.
# n8n "Tahmin et" node'u aynı değeri `Authorization: Bearer ...` header'ıyla gönderir.
# Üret: openssl rand -hex 32
Environment=PREDICT_SERVICE_TOKEN=PASTE_LONG_RANDOM_TOKEN_HERE
# Servis 0.0.0.0 dinler (Docker'daki n8n 172.17.0.1 üzerinden erişebilsin diye).
# 8000 portu dış ağa KAPALI olmalı: ufw deny 8000/tcp (Hetzner Cloud Firewall'da da açma).
ExecStart=/opt/football-match-analyzer/engine/.venv/bin/uvicorn service:app --host 0.0.0.0 --port 8000
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
